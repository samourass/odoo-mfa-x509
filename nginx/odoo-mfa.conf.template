# Nginx (installé sur la VM RHEL) : frontal TLS + authentification mutuelle (mTLS).
# Les marqueurs __ROOT__ et __SERVER_NAME__ sont remplacés par deploy/40-nginx.sh.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP -> HTTPS
server {
    listen 80;
    server_name __SERVER_NAME__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name __SERVER_NAME__;

    ssl_certificate         __ROOT__/pki/server/server.crt;
    ssl_certificate_key     __ROOT__/pki/server/server.key;
    ssl_protocols           TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # ===== Facteur « certificat X.509 » : authentification mutuelle =====
    ssl_client_certificate  __ROOT__/pki/ca/ca.crt;
    ssl_verify_client       on;
    ssl_verify_depth        1;
    ssl_crl                 __ROOT__/pki/ca/crl/ca.crl.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:8069;
        proxy_http_version 1.1;
        proxy_read_timeout 720s;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # Identité du certificat transmise à Odoo (toujours réécrite par Nginx :
        # un client ne peut pas forger ces en-têtes).
        proxy_set_header X-SSL-Client-Verify      $ssl_client_verify;
        proxy_set_header X-SSL-Client-S-DN        $ssl_client_s_dn;
        proxy_set_header X-SSL-Client-I-DN        $ssl_client_i_dn;
        proxy_set_header X-SSL-Client-Serial      $ssl_client_serial;
        proxy_set_header X-SSL-Client-Fingerprint $ssl_client_fingerprint;
    }
}
