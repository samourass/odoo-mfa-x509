<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mfa_user_certificate_list" model="ir.ui.view">
        <field name="name">mfa.user.certificate.list</field>
        <field name="model">mfa.user.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="serial_number"/>
                <field name="valid_until"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-danger="state == 'revoked'"/>
            </list>
        </field>
    </record>

    <record id="view_mfa_user_certificate_form" model="ir.ui.view">
        <field name="name">mfa.user.certificate.form</field>
        <field name="model">mfa.user.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state == 'active'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state != 'active'"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="state == 'revoked'"
                            confirm="Revoke this certificate in Odoo?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,suspended,revoked"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="state"/>
                    </group>
                    <group string="Certificate Information">
                        <field name="serial_number"/>
                        <field name="fingerprint_sha256"/>
                        <field name="subject_dn"/>
                        <field name="issuer_dn"/>
                        <field name="valid_from"/>
                        <field name="valid_until"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mfa_user_certificate_search" model="ir.ui.view">
        <field name="name">mfa.user.certificate.search</field>
        <field name="model">mfa.user.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="user_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="suspended" string="Suspended" domain="[('state', '=', 'suspended')]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
            </search>
        </field>
    </record>

    <record id="action_mfa_user_certificate" model="ir.actions.act_window">
        <field name="name">X.509 Certificates</field>
        <field name="res_model">mfa.user.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mfa_security_root" name="MFA Security"
              sequence="90" groups="base.group_system"/>
    <menuitem id="menu_mfa_certificates" name="X.509 Certificates"
              parent="menu_mfa_security_root"
              action="action_mfa_user_certificate" sequence="10"/>
</odoo>
